{
  "port": 8888,
  "host": "127.0.0.1",
  "allowedOrigins": [
    "http://localhost:8888",
    "http://127.0.0.1:8888"
  ],
  "defaultVolume": 0.5,
  "enableOBS": true,
  "enableWebsite": true,
  "enableAlbumArt": true,
  "logLevel": "INFO",
  "backupCount": 3,
  "progressBroadcastInterval": 1,
  "stateSaveDebounceSeconds": 2,
  "enableLyrics": true,
  "lyricsFetchTimeoutSeconds": 30,
  "lyricsProviderOrder": [
    "musixmatch",
    "lrclib"
  ],
  "musixmatchToken": "",
  "spicetifyPollingIntervalMs": 500,
  "spicetifyReconnectBaseDelayMs": 1000,
  "spicetifyReconnectMaxDelayMs": 10000,
  "spicetifyProgressDeltaThresholdMs": 500,
  "spicetifyCommandFeedbackDelayMs": 150,
  "soundcloudPollingIntervalMs": 500,
  "obsUpNextThresholdMs": 15000
}
